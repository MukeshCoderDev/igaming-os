# .env.example — copy to .env and fill in.
# Per DEC-0028 / ADR-0023, every required var here MUST be present in the
# environment. Missing required vars cause named-var loud failure at
# settings import time (sys.exit(1) before any DB/network call).
# Linter rule 13 enforces that this file covers every required var.

# ─── Required (validated at import time; missing → sys.exit(1)) ──────────
# Django secret key. Generate with: python -c "from django.core.management import utils; print(utils.get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key

# Database URL (postgres://user:pass@host:port/dbname).
DATABASE_URL=postgres://noventra_dev:noventra_dev_password@localhost:5432/noventra

# Redis URL (redis://host:port/db).
REDIS_URL=redis://localhost:6379/0

# ─── Optional (with safe defaults) ───────────────────────────────────────
# Django settings module. Default: local for dev; production for prod.
DJANGO_SETTINGS_MODULE=noventra.settings.local

# Debug mode. NEVER set to true in production.
DEBUG=true

# Allowed hosts (comma-separated). Use * for local dev; explicit list for prod.
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Docker-compose vars (used by docker-compose.yml) ───────────────────
POSTGRES_DB=noventra
POSTGRES_USER=noventra_dev
POSTGRES_PASSWORD=noventra_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379
APP_PORT=8000

# ─── Production hardening (set in prod; leave defaults in dev) ──────────
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_CONTENT_TYPE_NOSNIFF=false
SECURE_BROWSER_XSS_FILTER=false

