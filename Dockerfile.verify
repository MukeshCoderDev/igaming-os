# Dockerfile.verify — Stage B Verification Image
# Per the Stage B Verification Suite spec §1.2.

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e ".[dev]"

# Install verification-specific tools
RUN pip install --no-cache-dir \
    pytest \
    pytest-cov \
    pytest-asyncio \
    pytest-django \
    pytest-xdist \
    bandit \
    pip-audit \
    mypy \
    ruff \
    httpx \
    websockets \
    locust \
    hypothesis \
    factory-boy

COPY . .

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
